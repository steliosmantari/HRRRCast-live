{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadStagedSchedulerArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::mantari-cast1/hrrrcast/scheduler/launch-params.json",
        "arn:aws:s3:::mantari-cast1/hrrrcast/scheduler/user_data.template"
      ]
    },
    {
      "Sid": "ListOutputsForIdempotency",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::mantari-cast1",
      "Condition": {
        "StringLike": { "s3:prefix": "hrrrcast/out/*" }
      }
    },
    {
      "Sid": "InspectInstancesAndTypes",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeImages",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchOnlyInstancesTaggedHrrrcast",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1:334566771276:instance/*",
        "arn:aws:ec2:us-east-1:334566771276:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "hrrrcast"
        }
      }
    },
    {
      "Sid": "RunInstancesSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:334566771276:network-interface/*",
        "arn:aws:ec2:us-east-1:334566771276:subnet/*",
        "arn:aws:ec2:us-east-1:334566771276:security-group/*",
        "arn:aws:ec2:us-east-1:334566771276:key-pair/*"
      ]
    },
    {
      "Sid": "TagAtLaunchOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "ec2:CreateAction": "RunInstances" }
      }
    },
    {
      "Sid": "PassOnlyTheRunnerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::334566771276:role/hrrrcast-runner",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" }
      }
    },
    {
      "Sid": "ReadVcpuQuota",
      "Effect": "Allow",
      "Action": "servicequotas:GetServiceQuota",
      "Resource": "*"
    }
  ]
}
